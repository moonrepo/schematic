fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    use schematic::internal::*;
    Ok(
        match self {
            Self::Foo(_) => {
                Some(Self::Foo((&&DefaultString::<String>::new()).parse_default("abc")?))
            }
            _ => None,
        },
    )
}
