fn default_values(
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        Some(
            Self(
                Some(Default::default()),
                Some(Default::default()),
                None,
                Some(Vec::default()),
                Some(10),
                Some(10),
                Some(Default::default()),
            ),
        ),
    )
}
