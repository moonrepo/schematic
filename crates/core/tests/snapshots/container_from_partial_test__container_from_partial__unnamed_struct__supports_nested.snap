---
source: crates/core/tests/container_from_partial_test.rs
expression: pretty(container.impl_full_from_partial())
---
fn from_partial(partial: Self::Partial) -> Self {
    Self(
        {
            let data = partial.0.unwrap_or_default();
            <NestedConfig as schematic::Config>::from_partial(data)
        },
        {
            let data = partial.1.unwrap_or_default();
            <CustomConfig as schematic::Config>::from_partial(data)
        },
        {
            let data = partial.2;
            match data {
                Some(data) => {
                    Some(<NestedConfig as schematic::Config>::from_partial(data))
                }
                None => None,
            }
        },
        {
            let data = partial.3.unwrap_or_default();
            std::sync::Arc::new(<CustomConfig as schematic::Config>::from_partial(data))
        },
        {
            let data = partial.4.unwrap_or_default();
            std::boxed::Box::new(<NestedConfig as schematic::Config>::from_partial(data))
        },
    )
}
