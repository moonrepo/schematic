---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "alpha".into(),
                        Schema::literal_value(LiteralValue::String("alpha".into())),
                    ),
                    (
                        "flag".into(),
                        schema.infer_with_default::<bool>(LiteralValue::Bool(true)),
                    ),
                ],
                Some(1usize),
            ),
        )
}
