---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "Text".into(),
                        {
                            let mut item = Schema::tagged(
                                TaggedType::new(
                                    TagFormat::External,
                                    "Text",
                                    Some(schema.infer::<String>()),
                                ),
                            );
                            item.description = Some("Docs.".into());
                            item
                        },
                    ),
                    (
                        "List".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "List",
                                Some(schema.infer::<Vec<String>>()),
                            ),
                        ),
                    ),
                    (
                        "Pair".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "Pair",
                                Some(
                                    Schema::tuple(
                                        TupleType::new([
                                            schema.infer::<usize>(),
                                            schema.infer::<bool>(),
                                        ]),
                                    ),
                                ),
                            ),
                        ),
                    ),
                    (
                        "Inner".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "Inner",
                                Some({
                                    let mut item = schema.infer_as_nested::<NestedConfig>();
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "InnerOpt".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "InnerOpt",
                                Some({
                                    let mut item = schema
                                        .infer_as_nested::<Option<NestedConfig>>();
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "InnerList".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "InnerList",
                                Some({
                                    let mut item = schema
                                        .infer_as_nested::<Vec<NestedConfig>>();
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "InnerMap".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "InnerMap",
                                Some({
                                    let mut item = schema
                                        .infer_as_nested::<HashMap<String, CustomConfig>>();
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "Unit".into(),
                        Schema::literal_value(LiteralValue::String("Unit".into())),
                    ),
                ],
                Some(2usize),
            ),
        )
}
