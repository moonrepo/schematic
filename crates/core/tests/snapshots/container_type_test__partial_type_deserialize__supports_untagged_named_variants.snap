#[automatically_derived]
impl<'de> serde::Deserialize<'de> for PartialExample {
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let mut attempts = schematic::internal::untagged::UntaggedManager::new(
            deserializer,
        )?;
        if let Some(value) = attempts.variant::<bool>("A") {
            return Ok(PartialExample::A(value));
        }
        {
            #[derive(serde::Deserialize)]
            #[serde(deny_unknown_fields, rename_all = "camelCase")]
            struct Variant {
                #[serde(skip_serializing_if = "Option::is_none", default)]
                some_value: Option<usize>,
                #[serde(
                    alias = "o",
                    rename = "other",
                    skip_serializing_if = "Option::is_none",
                    default
                )]
                other_value: Option<String>,
                #[serde(skip_serializing_if = "Option::is_none", default)]
                child: Option<<NestedConfig as schematic::Config>::Partial>,
            }
            if let Some(value) = attempts.variant::<Variant>("B") {
                return Ok(PartialExample::B {
                    some_value: value.some_value,
                    other_value: value.other_value,
                    child: value.child,
                });
            }
        }
        {
            #[derive(serde::Deserialize)]
            #[serde(deny_unknown_fields, rename_all = "kebab-case")]
            struct Variant {
                #[serde(skip_serializing_if = "Option::is_none", default)]
                some_value: Option<bool>,
            }
            if let Some(value) = attempts.variant::<Variant>("C") {
                return Ok(PartialExample::C {
                    some_value: value.some_value,
                });
            }
        }
        {
            #[derive(serde::Deserialize)]
            #[serde(deny_unknown_fields)]
            struct Variant {}
            if attempts.variant::<Variant>("D").is_some() {
                return Ok(PartialExample::D {});
            }
        }
        Err(attempts.into_error(stringify!(PartialExample)))
    }
