source: crates/core/tests/container_from_partial_test.rs
expression: pretty(container.impl_full_from_partial())
---
fn from_partial(partial: Self::Partial) -> Self {
    match partial {
        PartialExample::A(pa) => {
            Self::A({
                let mut list = Vec::default();
                for pa in pa {
                    list.push(NestedConfig::from_partial(pa));
                }
                list
            })
        }
        PartialExample::B(pa) => {
            Self::B({
                let mut map = HashMap::default();
                for (key, pa) in pa {
                    map.insert(key, CustomConfig::from_partial(pa));
                }
                map
            })
        }
        PartialExample::C(pa) => {
            Self::C(
                match pa {
                    Some(pa) => {
                        Some({
                            let mut set = BTreeSet::default();
                            for pa in pa {
                                set.insert(NestedConfig::from_partial(pa));
                            }
                            set
                        })
                    }
                    None => None,
                },
            )
        }
    }
}
