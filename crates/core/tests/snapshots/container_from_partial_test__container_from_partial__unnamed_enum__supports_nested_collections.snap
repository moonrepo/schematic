---
source: crates/core/tests/container_from_partial_test.rs
expression: pretty(container.impl_full_from_partial())
---
fn from_partial(partial: Self::Partial) -> Self {
    match partial {
        PartialExample::A(pa) => {
            Self::A(
                pa
                    .into_iter()
                    .map(|pa| <NestedConfig as schematic::Config>::from_partial(pa))
                    .collect(),
            )
        }
        PartialExample::B(pa) => {
            Self::B(
                pa
                    .into_iter()
                    .map(|(key, pa)| (
                        key,
                        <CustomConfig as schematic::Config>::from_partial(pa),
                    ))
                    .collect(),
            )
        }
        PartialExample::C(pa) => {
            Self::C(
                match pa {
                    Some(pa) => {
                        Some(
                            pa
                                .into_iter()
                                .map(|pa| <NestedConfig as schematic::Config>::from_partial(
                                    pa,
                                ))
                                .collect(),
                        )
                    }
                    None => None,
                },
            )
        }
    }
}
