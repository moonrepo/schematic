    fn settings() -> schematic::ConfigSettingMap {
        use schematic::ConfigSetting;
        std::collections::BTreeMap::from_iter([
            ("0".into(), ConfigSetting::new("usize")),
            (
                "1".into(),
                ConfigSetting::new("Option<NestedConfig>")
                    .nested(NestedConfig::settings()),
            ),
        ])
    }
