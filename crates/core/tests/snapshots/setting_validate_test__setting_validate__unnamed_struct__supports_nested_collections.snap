fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    use schematic::internal::*;
    let mut validate = ValidateManager::new(context, finalizing, path);
    if let Some(setting) = &self.0 {
        validate.check("0", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("0");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.1 {
        validate.check("1", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("1");
            let item = setting;
            for (key, item) in item {
                let path = path.join_key(key);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.2 {
        validate.check("2", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("2");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.3 {
        {
            let path = validate.key_path("3");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.4 {
        {
            let path = validate.key_path("4");
            let item = setting;
            for (key, item) in item {
                let path = path.join_key(key);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.5 {
        {
            let path = validate.key_path("5");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if !validate.errors.is_empty() {
        return Err(validate.errors);
    }
    Ok(())
}
