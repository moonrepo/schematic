---
fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        match self {
            Self::Foo(_) => {
                Some(
                    Self::Foo(
                        schematic::internal::defaults::handle_default_result(
                                "Foo",
                                default_count(context),
                            )?
                            .unwrap_or_default(),
                    ),
                )
            }
            _ => None,
        },
    )
}
