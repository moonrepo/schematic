source: crates/core/tests/setting_default_test.rs
expression: pretty(container.impl_partial_default_values())
---
fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        Some(Self {
            a: match self.a.as_ref() {
                Some(inner) => {
                    <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                        inner,
                        context,
                    )?
                }
                None => None,
            },
            b: match self.b.as_ref() {
                Some(inner) => {
                    <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                        inner,
                        schematic::context::unit(context),
                    )?
                }
                None => None,
            },
            c: match self.c.as_deref() {
                Some(inner) => {
                    <<Example as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                            inner,
                            context,
                        )?
                        .map(Box::new)
                }
                None => None,
            },
            d: match self.d.as_ref() {
                Some(inner) => {
                    <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                        inner,
                        context,
                    )?
                }
                None => None,
            },
            e: Some(1),
        }),
    )
}
