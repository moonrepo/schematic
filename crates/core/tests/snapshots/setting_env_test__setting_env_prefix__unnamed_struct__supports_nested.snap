expression: pretty(container.impl_partial_env_values())
---
fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    self.env_values_with_prefix(None)
}
fn env_values_with_prefix(
    &self,
    prefix: Option<&str>,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    let mut env = schematic::internal::env::EnvManager::new(prefix, None);
    let mut partial = Self::default();
    partial.0 = env
        .nested(schematic::internal::layers::nested_env_values(self.0.as_ref(), None)?)?;
    partial.1 = env
        .nested(schematic::internal::layers::nested_env_values(self.1.as_ref(), None)?)?;
    partial.2 = env
        .nested(
            schematic::internal::layers::nested_env_values(
                self.2.as_ref(),
                Some("PRE_"),
            )?,
        )?;
    partial.3 = env
        .nested(
            schematic::internal::layers::nested_env_values(
                self.3.as_ref(),
                Some("PRE_"),
            )?,
        )?;
    Ok(if env.is_empty() { None } else { Some(partial) })
}
