---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "text".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "text",
                                Some(schema.infer::<String>()),
                            ),
                        ),
                    ),
                    (
                        "number".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "number",
                                Some(schema.infer::<usize>()),
                            ),
                        ),
                    ),
                    (
                        "Last".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::External,
                                "Last",
                                Some(schema.infer::<bool>()),
                            ),
                        ),
                    ),
                ],
                Some(2usize),
            ),
        )
}
