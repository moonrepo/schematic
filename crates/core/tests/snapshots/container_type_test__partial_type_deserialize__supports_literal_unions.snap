#[automatically_derived]
impl<'de> serde::Deserialize<'de> for PartialExample {
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        use serde::de::Error as _;
        let content = schematic::internal::buffer_untagged_content(deserializer)?;
        let mut errors: Vec<(&str, String)> = Vec::new();
        match schematic::internal::literal_content(&content) {
            Some("alpha" | "a") => return Ok(PartialExample::Alpha),
            Some("bb") => return Ok(PartialExample::Beta),
            _ => {
                errors
                    .push((
                        "",
                        schematic::internal::literal_error_message(
                            &["alpha", "bb"],
                            &content,
                        ),
                    ))
            }
        }
        match schematic::internal::deserialize_untagged_variant::<bool>(&content) {
            Ok(value) => return Ok(PartialExample::Flag(value)),
            Err(error) => errors.push(("flag", error)),
        }
        match schematic::internal::deserialize_untagged_variant::<
            (usize, String),
        >(&content) {
            Ok(value) => return Ok(PartialExample::Pair(value.0, value.1)),
            Err(error) => errors.push(("pair", error)),
        }
        if schematic::internal::is_null_content(&content) {
            return Ok(PartialExample::Missing);
        }
        errors.push(("missing", "expected null".to_owned()));
        Err(
            D::Error::custom(
                schematic::internal::untagged_error_message(
                    stringify!(PartialExample),
                    &errors,
                ),
            ),
        )
    }
}
