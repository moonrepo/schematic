fn merge(
    &mut self,
    context: &Self::Context,
    mut next: Self,
) -> std::result::Result<(), schematic::ConfigError> {
    use schematic::internal::*;
    MergeManager::new(context).apply(&mut self.0, next.0)?.apply(&mut self.1, next.1)?;
    Ok(())
}
