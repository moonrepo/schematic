---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "None".into(),
                        Schema::structure(
                            StructType::new([
                                (
                                    "type".into(),
                                    {
                                        let mut field = SchemaField::new(
                                            Schema::literal_value(LiteralValue::String("None".into())),
                                        );
                                        field.env_var = Some("AUTH_TYPE".into());
                                        field
                                    },
                                ),
                            ]),
                        ),
                    ),
                    (
                        "Token".into(),
                        {
                            let mut item = {
                                let mut item = Schema::structure(
                                    StructType::new([
                                        (
                                            "token".into(),
                                            {
                                                let mut field = SchemaField::new(schema.infer::<String>());
                                                field.env_var = Some("AUTH_TOKEN".into());
                                                field
                                            },
                                        ),
                                    ]),
                                );
                                if item
                                    .ty
                                    .add_field(
                                        "type",
                                        {
                                            let mut field = SchemaField::new(
                                                Schema::literal_value(LiteralValue::String("Token".into())),
                                            );
                                            field.env_var = Some("AUTH_TYPE".into());
                                            field
                                        },
                                    )
                                {
                                    item.name = None;
                                }
                                item
                            };
                            item.partialize();
                            item
                        },
                    ),
                    (
                        "Nested".into(),
                        {
                            let mut item = {
                                let mut item = schema.infer_as_nested::<NestedConfig>();
                                if item
                                    .ty
                                    .add_field(
                                        "type",
                                        {
                                            let mut field = SchemaField::new(
                                                Schema::literal_value(LiteralValue::String("Nested".into())),
                                            );
                                            field.env_var = Some("AUTH_TYPE".into());
                                            field
                                        },
                                    )
                                {
                                    item.name = None;
                                }
                                item
                            };
                            item.partialize();
                            item
                        },
                    ),
                    (
                        "Path".into(),
                        {
                            let mut item = schema.infer::<String>();
                            if item
                                .ty
                                .add_field(
                                    "type",
                                    SchemaField::new(
                                        Schema::literal_value(LiteralValue::String("Path".into())),
                                    ),
                                )
                            {
                                item.name = None;
                            }
                            item
                        },
                    ),
                ],
                None,
            ),
        )
}
