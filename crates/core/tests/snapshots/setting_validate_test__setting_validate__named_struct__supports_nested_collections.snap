fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    use schematic::internal::*;
    let mut validate = ValidateManager::new(context, finalizing, path);
    if let Some(setting) = &self.a {
        validate.check("a", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("a");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.b {
        validate.check("b", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("b");
            let item = setting;
            for (key, item) in item {
                let path = path.join_key(key);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.c {
        validate.check("c", setting, self, |v, d, c, f| func_ref(v, d, c, f));
        {
            let path = validate.key_path("c");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.d {
        {
            let path = validate.key_path("d");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.e {
        {
            let path = validate.key_path("e");
            let item = setting;
            for (key, item) in item {
                let path = path.join_key(key);
                validate.nested_at(path, item);
            }
        }
    }
    if let Some(setting) = &self.f {
        {
            let path = validate.key_path("f");
            let item = setting;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
    }
    if !validate.errors.is_empty() {
        return Err(validate.errors);
    }
    Ok(())
}
