---
source: crates/core/tests/setting_validate_test.rs
expression: pretty(container.impl_partial_validate())
---
fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    let mut validate = schematic::internal::validate::ValidateManager::new(
        context,
        finalizing,
        path,
    );
    match self {
        Self::A { a: pa, b: pb, c: pc, d: pd, e: pe, f: pf, .. } => {
            validate
                .named_variant(
                    "A",
                    |validate| {
                        if let Some(setting) = pa {
                            validate
                                .check(
                                    "a",
                                    setting,
                                    self,
                                    |v, d, c, f| func_ref(v, d, c, f),
                                );
                            validate.nested("a", setting);
                        } else {
                            validate
                                .missing_nested::<
                                    <NestedConfig as schematic::Config>::Partial,
                                >("a");
                        }
                        if let Some(setting) = pb {
                            validate
                                .check(
                                    "b",
                                    setting,
                                    self,
                                    |v, d, c, f| func_ref(v, d, c, f),
                                );
                            validate.nested("b", setting);
                        } else {
                            validate
                                .missing_nested::<
                                    <CustomConfig as schematic::Config>::Partial,
                                >("b");
                        }
                        if let Some(setting) = pc {
                            validate
                                .check(
                                    "c",
                                    setting,
                                    self,
                                    |v, d, c, f| func_ref(v, d, c, f),
                                );
                            validate.nested("c", setting);
                        }
                        if let Some(setting) = pd {
                            validate
                                .check(
                                    "d",
                                    setting,
                                    self,
                                    |v, d, c, f| func_ref(v, d, c, f),
                                );
                            validate.nested("d", setting);
                        } else {
                            validate
                                .missing_nested::<
                                    <CustomConfig as schematic::Config>::Partial,
                                >("d");
                        }
                        if let Some(setting) = pe {
                            validate.nested("e", setting);
                        } else {
                            validate
                                .missing_nested::<
                                    <NestedConfig as schematic::Config>::Partial,
                                >("e");
                        }
                        if let Some(setting) = pf {
                            validate.flattened(setting);
                        } else {
                            validate
                                .missing_flattened::<
                                    <NestedConfig as schematic::Config>::Partial,
                                >();
                        }
                    },
                );
        }
        _ => {}
    };
    validate.finish()
}
