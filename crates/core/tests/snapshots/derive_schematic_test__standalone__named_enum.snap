#[automatically_derived]
impl schematic::Schematic for Example {
    fn schema_name() -> Option<String> {
        Some("Example".into())
    }
    fn build_schema(mut schema: schematic::SchemaBuilder) -> schematic::Schema {
        use schematic::schema::*;
        schema
            .union(
                UnionType::from_named_schemas(
                    [
                        (
                            "A".into(),
                            Schema::tagged(
                                TaggedType::new(
                                    TagFormat::Internal {
                                        tag: "type".into(),
                                    },
                                    "A",
                                    Some({
                                        let mut structure = StructType::new([
                                            ("a".into(), SchemaField::new(schema.infer::<bool>())),
                                            (
                                                "b".into(),
                                                {
                                                    let mut field = SchemaField::new(schema.infer::<usize>());
                                                    field.comment = Some("Field docs.".into());
                                                    field.default = Some(LiteralValue::Int(1));
                                                    field.optional = true;
                                                    field
                                                },
                                            ),
                                            (
                                                "c".into(),
                                                {
                                                    let mut field = SchemaField::new(
                                                        schema.infer::<Option<String>>(),
                                                    );
                                                    field.nullable = true;
                                                    field.optional = true;
                                                    field
                                                },
                                            ),
                                        ]);
                                        structure.allow_unknown_fields = true;
                                        Schema::structure(structure)
                                    }),
                                ),
                            ),
                        ),
                        (
                            "B".into(),
                            Schema::tagged(
                                TaggedType::new(
                                    TagFormat::Internal {
                                        tag: "type".into(),
                                    },
                                    "B",
                                    Some(schema.infer::<String>()),
                                ),
                            ),
                        ),
                    ],
                    None,
                ),
            )
    }
}
