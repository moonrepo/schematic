---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "A".into(),
                        {
                            let mut item = Schema::tagged(
                                TaggedType::new(
                                    TagFormat::Internal {
                                        tag: "type".into(),
                                    },
                                    "A",
                                    Some({
                                        let mut item = Schema::structure(
                                            StructType::new([
                                                (
                                                    "a".into(),
                                                    {
                                                        let mut field = SchemaField::new(schema.infer::<String>());
                                                        field.comment = Some("Field docs.".into());
                                                        field
                                                    },
                                                ),
                                                (
                                                    "b".into(),
                                                    {
                                                        let mut field = SchemaField::new(schema.infer::<usize>());
                                                        field.default = Some(LiteralValue::Int(10));
                                                        field.optional = true;
                                                        field
                                                    },
                                                ),
                                                (
                                                    "c".into(),
                                                    {
                                                        let mut field = SchemaField::new(
                                                            schema.infer::<Option<bool>>(),
                                                        );
                                                        field.nullable = true;
                                                        field.optional = true;
                                                        field
                                                    },
                                                ),
                                                ("d".into(), SchemaField::new(schema.infer::<String>())),
                                            ]),
                                        );
                                        item.partialize();
                                        item
                                    }),
                                ),
                            );
                            item.description = Some("Docs.".into());
                            item
                        },
                    ),
                    (
                        "B".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::Internal {
                                    tag: "type".into(),
                                },
                                "B",
                                Some({
                                    let mut item = Schema::structure(
                                        StructType::new([
                                            (
                                                "inner".into(),
                                                SchemaField::new(schema.infer_as_nested::<NestedConfig>()),
                                            ),
                                            (
                                                "inner_opt".into(),
                                                {
                                                    let mut field = SchemaField::new(
                                                        schema.infer_as_nested::<Option<NestedConfig>>(),
                                                    );
                                                    field.nullable = true;
                                                    field.optional = true;
                                                    field
                                                },
                                            ),
                                            (
                                                "inner_map".into(),
                                                SchemaField::new(
                                                    schema.infer_as_nested::<HashMap<String, CustomConfig>>(),
                                                ),
                                            ),
                                        ]),
                                    );
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "C".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::Internal {
                                    tag: "type".into(),
                                },
                                "C",
                                Some({
                                    let mut item = Schema::structure(StructType::default());
                                    item.partialize();
                                    item
                                }),
                            ),
                        ),
                    ),
                    (
                        "Text".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::Internal {
                                    tag: "type".into(),
                                },
                                "Text",
                                Some(schema.infer::<String>()),
                            ),
                        ),
                    ),
                    (
                        "Unit".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::Internal {
                                    tag: "type".into(),
                                },
                                "Unit",
                                None,
                            ),
                        ),
                    ),
                ],
                Some(1usize),
            ),
        )
}
