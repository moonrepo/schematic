---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    Ok(
        match self {
            Self::A { a: mut pa, b: mut pb, c: mut pc, d: mut pd } => {
                if let Some(layer) = pa {
                    pa = Some(layer.finalize(context)?);
                }
                if let Some(layer) = pb {
                    pb = Some(
                        schematic::internal::transform::handle_transform_result(
                            "A.b",
                            transform_config(layer.finalize(context)?, context),
                        )?,
                    );
                }
                if let Some(layer) = pc {
                    pc = Some(layer.finalize(context)?);
                }
                if let Some(layer) = pd {
                    pd = Some(
                        schematic::internal::transform::handle_transform_result(
                            "A.d",
                            transform_config(layer.finalize(context)?, context),
                        )?,
                    );
                }
                Self::A {
                    a: pa,
                    b: pb,
                    c: pc,
                    d: pd,
                }
            }
            _ => self,
        },
    )
}
