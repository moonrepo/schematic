fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    use schematic::internal::*;
    let mut validate = ValidateManager::new(context, finalizing, path);
    match self {
        Self::A(pa) => {
            validate.nested("A.0", pa);
        }
        Self::B(pa) => {
            if let Some(pa) = pa {
                validate.nested("B.0", pa);
            }
        }
        Self::C(pa) => {
            validate.nested("C.0", pa);
        }
        Self::D(pa) => {
            if let Some(pa) = pa {
                validate.nested_list("D.0", pa.iter());
            }
        }
        Self::E(pa) => {
            validate.nested_list("E.0", pa.iter());
        }
        _ => {}
    };
    if !validate.errors.is_empty() {
        return Err(validate.errors);
    }
    Ok(())
}
