fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        Some(Self {
            a: Some(PathBuf::from("a").join("b")),
            b: Some(-1),
            c: Some(if cfg!(windows) { 1 } else { 2 }),
            d: Some(60 * 60),
        }),
    )
}
