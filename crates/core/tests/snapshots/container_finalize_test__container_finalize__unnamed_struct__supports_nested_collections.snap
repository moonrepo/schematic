expression: pretty(container.impl_partial_finalize())
---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    let mut partial = Self::default();
    if let Some(layer) = Self::default_values(context)? {
        partial.merge(context, layer)?;
    }
    partial.merge(context, self)?;
    if let Some(layer) = Self::env_values()? {
        partial.merge(context, layer)?;
    }
    partial.finalize_nested(context)
}
fn finalize_nested(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    let mut partial = self;
    if let Some(layer) = partial.0 {
        partial.0 = Some(
            layer
                .into_iter()
                .map(|layer| layer.finalize(context))
                .collect::<
                    std::result::Result<
                        Vec<<NestedConfig as schematic::Config>::Partial>,
                        schematic::ConfigError,
                    >,
                >()?,
        );
    }
    if let Some(layer) = partial.1 {
        partial.1 = Some(
            transform_config(
                layer
                    .into_iter()
                    .map(|(key, layer)| Ok((key, layer.finalize(context)?)))
                    .collect::<
                        std::result::Result<
                            HashMap<
                                String,
                                <CustomConfig as schematic::Config>::Partial,
                            >,
                            schematic::ConfigError,
                        >,
                    >()?,
                context,
            )?,
        );
    }
    if let Some(layer) = partial.2 {
        partial.2 = Some(
            transform_config(
                layer
                    .into_iter()
                    .map(|layer| layer.finalize(context))
                    .collect::<
                        std::result::Result<
                            BTreeSet<<NestedConfig as schematic::Config>::Partial>,
                            schematic::ConfigError,
                        >,
                    >()?,
                context,
            )?,
        );
    }
    Ok(partial)
}
