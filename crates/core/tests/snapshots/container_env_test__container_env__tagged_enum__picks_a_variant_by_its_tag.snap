expression: pretty(container.impl_partial_env_values())
---
fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    self.env_values_with_prefix(None)
}
fn env_values_with_prefix(
    &self,
    prefix: Option<&str>,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    let picked = schematic::internal::env::EnvManager::new(prefix, Some("AUTH_"))
        .pick_variant(
            "TYPE",
            self,
            &["none", "token", "basic_auth", "nested"],
            |value| match value {
                "none" => Some(Self::None),
                "token" | "tok" => {
                    Some(Self::Token {
                        token: Default::default(),
                        expires: Default::default(),
                    })
                }
                "basic_auth" => {
                    Some(Self::BasicAuth {
                        user: Default::default(),
                    })
                }
                "nested" => Some(Self::Nested(Default::default())),
                _ => None,
            },
        )?;
    let mut env = schematic::internal::env::EnvManager::new(prefix, Some("AUTH_"));
    let value = match picked.as_ref().unwrap_or(self) {
        Self::Token { .. } => {
            Self::Token {
                token: env.get_prefixed("TOKEN")?,
                expires: env.get_prefixed("EXPIRES")?,
            }
        }
        Self::BasicAuth { .. } => {
            Self::BasicAuth {
                user: env.get_prefixed("USER")?,
            }
        }
        Self::Nested(pa) => {
            Self::Nested(
                env
                    .nested(
                        schematic::internal::layers::nested_env_values(Some(pa), None)?,
                    )?
                    .unwrap_or_default(),
            )
        }
        _ => return Ok(picked),
    };
    Ok(env.finish(value).or(picked))
}
