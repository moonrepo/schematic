---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    Ok(
        match self {
            Self::A { a: pa, b: pb, c: mut pc, d: pd, e: pe, f: mut pf, g: pg } => {
                if let Some(layer) = pc {
                    pc = Some(transform_string(layer, context)?);
                }
                if let Some(layer) = pf {
                    pf = Some(transform_vec(layer, context)?);
                }
                Self::A {
                    a: pa,
                    b: pb,
                    c: pc,
                    d: pd,
                    e: pe,
                    f: pf,
                    g: pg,
                }
            }
            _ => self,
        },
    )
}
