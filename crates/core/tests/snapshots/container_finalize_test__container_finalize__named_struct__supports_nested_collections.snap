---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    let mut partial = self;
    if let Some(layer) = partial.a {
        partial.a = Some(
            layer
                .into_iter()
                .map(|layer| schematic::internal::finalize_with_layers(layer, context))
                .collect::<
                    std::result::Result<
                        Vec<<NestedConfig as schematic::Config>::Partial>,
                        schematic::ConfigError,
                    >,
                >()?,
        );
    }
    if let Some(layer) = partial.b {
        partial.b = Some(
            transform_config(
                layer
                    .into_iter()
                    .map(|(key, layer)| Ok((
                        key,
                        schematic::internal::finalize_with_layers(layer, context)?,
                    )))
                    .collect::<
                        std::result::Result<
                            HashMap<
                                String,
                                <CustomConfig as schematic::Config>::Partial,
                            >,
                            schematic::ConfigError,
                        >,
                    >()?,
                context,
            )?,
        );
    }
    if let Some(layer) = partial.c {
        partial.c = Some(
            transform_config(
                layer
                    .into_iter()
                    .map(|layer| schematic::internal::finalize_with_layers(
                        layer,
                        context,
                    ))
                    .collect::<
                        std::result::Result<
                            BTreeSet<<NestedConfig as schematic::Config>::Partial>,
                            schematic::ConfigError,
                        >,
                    >()?,
                context,
            )?,
        );
    }
    Ok(partial)
}
