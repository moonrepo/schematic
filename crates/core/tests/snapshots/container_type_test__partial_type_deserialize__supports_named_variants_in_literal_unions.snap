#[automatically_derived]
impl<'de> serde::Deserialize<'de> for PartialExample {
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let mut attempts = schematic::internal::untagged::UntaggedManager::new(
            deserializer,
        )?;
        if let Some(value) = attempts
            .literal(
                &["A"],
                |value| match value {
                    "A" => Some(PartialExample::A),
                    _ => None,
                },
            )
        {
            return Ok(value);
        }
        {
            #[derive(serde::Deserialize)]
            struct Variant {
                #[serde(skip_serializing_if = "Option::is_none", default)]
                value: Option<usize>,
            }
            if let Some(value) = attempts.variant::<Variant>("B") {
                return Ok(PartialExample::B {
                    value: value.value,
                });
            }
        }
        Err(attempts.into_error(stringify!(PartialExample)))
    }
}
