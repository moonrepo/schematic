    fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        self.env_values_with_prefix(None)
    }
    fn env_values_with_prefix(
        &self,
        prefix: Option<&str>,
    ) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        let mut env = schematic::internal::env::EnvManager::new(prefix, None);
        let value = match self {
            Self::A { b: pb, .. } => {
                Self::A {
                    a: None,
                    b: env
                        .nested(
                            schematic::internal::layers::nested_env_values(
                                pb.as_ref(),
                                None,
                            )?,
                        )?,
                }
            }
            _ => return Ok(None),
        };
        Ok(env.finish(value))
    }
    fn finalize(
        self,
        context: &Self::Context,
    ) -> std::result::Result<Self, schematic::ConfigError> {
        Ok(
            match self {
                Self::A { a: pa, b: mut pb } => {
                    if let Some(layer) = pb {
                        pb = Some(layer.finalize(context)?);
                    }
                    Self::A { a: pa, b: pb }
                }
                _ => self,
            },
        )
    }
    fn merge(
        &mut self,
        context: &Self::Context,
        mut next: Self,
    ) -> std::result::Result<(), schematic::ConfigError> {
        match self {
            Self::A { a: pa, b: pb } => {
                if let Self::A { a: na, b: nb } = next {
                    schematic::internal::merge::MergeManager::new(context)
                        .apply(pa, na)?
                        .nested(pb, nb)?;
                } else {
                    *self = next;
                }
            }
            Self::B { c: pa } => {
                if let Self::B { c: na } = next {
                    schematic::internal::merge::MergeManager::new(context)
                        .apply(pa, na)?;
                } else {
                    *self = next;
                }
            }
            _ => {
                *self = next;
            }
        };
        Ok(())
    }
    fn validate_with_path(
        &self,
        context: &Self::Context,
        finalizing: bool,
        path: schematic::Path,
    ) -> std::result::Result<(), Vec<schematic::ValidateError>> {
        let mut validate = schematic::internal::validate::ValidateManager::new(
            context,
            finalizing,
            path,
        );
        match self {
            Self::A { b: pb, .. } => {
                validate
                    .named_variant(
                        "A",
                        |validate| {
                            if let Some(setting) = pb {
                                validate.nested("b", setting);
                            } else {
                                validate
                                    .missing_nested::<
                                        <NestedConfig as schematic::Config>::Partial,
                                    >("b");
                            }
                        },
                    );
            }
            Self::B { c: pa, .. } => {
                validate
                    .named_variant(
                        "B",
                        |validate| {
                            if let Some(setting) = pa {
                                validate
                                    .check(
                                        "c",
                                        setting,
                                        self,
                                        |v, d, c, f| func_ref(v, d, c, f),
                                    );
                            }
                            if pa.is_none() {
                                validate.required("c");
                            }
                        },
                    );
            }
            _ => {}
        };
        validate.finish()
    }
