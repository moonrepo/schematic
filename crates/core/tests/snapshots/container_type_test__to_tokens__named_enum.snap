            (
                "A".into(),
                ConfigSetting::new("A")
                    .nested(
                        std::collections::BTreeMap::from_iter([
                            ("a".into(), ConfigSetting::new("String")),
                            (
                                "b".into(),
                                schematic::internal::settings::with_nested_settings::<
                                    NestedConfig,
                                >(ConfigSetting::new("NestedConfig")),
                            ),
                        ]),
                    ),
            ),
            (
                "B".into(),
                ConfigSetting::new("B")
                    .nested(
