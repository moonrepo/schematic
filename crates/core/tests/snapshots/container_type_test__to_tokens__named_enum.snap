impl schematic::Config for Example {
    type Partial = PartialExample;
    fn default_partial() -> Self::Partial {
        use schematic::internal::*;
        #[allow(unused_variables)]
        let context: &<Self::Partial as schematic::PartialConfig>::Context = &Default::default();
        let partial = (|| -> std::result::Result<Self::Partial, schematic::ConfigError> {
            Ok(PartialExample::A {
                a: Some((&&DefaultString::<String>::new()).parse_default("a")?),
                b: Some(<NestedConfig as schematic::Config>::default_partial()),
            })
        })();
        partial.expect("Failed to generate default values.")
    }
    fn from_partial(partial: Self::Partial) -> Self {
        match partial {
            PartialExample::A { a: pa, b: pb } => {
                Self::A {
                    a: pa.unwrap_or_default(),
                    b: {
                        let data = pb.unwrap_or_default();
                        <NestedConfig as schematic::Config>::from_partial(data)
                    },
                }
            }
            PartialExample::B { c: pa } => Self::B { c: pa },
        }
    }
    fn settings() -> schematic::ConfigSettingMap {
        use schematic::ConfigSetting;
        std::collections::BTreeMap::from_iter([
            (
                "A".into(),
                ConfigSetting::new("A")
                    .nested(
                        std::collections::BTreeMap::from_iter([
                            ("a".into(), ConfigSetting::new("String")),
                            (
                                "b".into(),
                                schematic::internal::with_nested_settings::<
                                    NestedConfig,
                                >(ConfigSetting::new("NestedConfig")),
                            ),
                        ]),
                    ),
            ),
            (
                "B".into(),
                ConfigSetting::new("B")
                    .nested(
                        std::collections::BTreeMap::from_iter([
                            ("c".into(), ConfigSetting::new("Option<bool>")),
                        ]),
                    ),
            ),
        ])
    }
}
