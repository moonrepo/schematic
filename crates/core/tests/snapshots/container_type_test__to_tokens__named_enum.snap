#[derive(Clone, Debug, PartialEq, serde::Deserialize, serde::Serialize)]
#[serde(tag = "type", deny_unknown_fields)]
enum PartialExample {
    A {
        #[serde(skip_serializing_if = "Option::is_none", default)]
        a: Option<String>,
        #[serde(skip_serializing_if = "Option::is_none", default)]
        b: Option<<NestedConfig as schematic::Config>::Partial>,
    },
    B { #[serde(skip_serializing_if = "Option::is_none", default)] c: Option<bool> },
}
#[automatically_derived]
impl Default for PartialExample {
    fn default() -> Self {
        Self::A {
            a: Default::default(),
            b: Default::default(),
        }
    }
}
#[automatically_derived]
impl schematic::PartialConfig for PartialExample {
    type Context = ();
    fn default_values(
        context: &Self::Context,
    ) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        Ok(
            Some(Self::A {
                a: Default::default(),
                b: Default::default(),
            }),
        )
    }
    fn finalize(
        self,
        context: &Self::Context,
    ) -> std::result::Result<Self, schematic::ConfigError> {
        use schematic::internal::*;
        Ok(
            match self {
                Self::A { a: na, b: nb } => {
                    let mut pa = Some(
                        (&&DefaultString::<String>::new()).parse_default("a")?,
                    );
                    let mut pb = <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                        context,
                    )?;
                    MergeManager::new(context).apply(&mut pa, na)?.nested(&mut pb, nb)?;
                    if let Some(layer) = pb {
                        pb = Some(layer.finalize(context)?);
                    }
                    Self::A { a: pa, b: pb }
                }
                _ => self,
            },
        )
    }
    fn merge(
        &mut self,
        context: &Self::Context,
        mut next: Self,
    ) -> std::result::Result<(), schematic::ConfigError> {
        use schematic::internal::*;
        match self {
            Self::A { a: pa, b: pb } => {
                if let Self::A { a: na, b: nb } = next {
                    MergeManager::new(context).apply(pa, na)?.nested(pb, nb)?;
                } else {
                    *self = next;
                }
            }
            Self::B { c: pa } => {
                if let Self::B { c: na } = next {
                    MergeManager::new(context).apply(pa, na)?;
                } else {
                    *self = next;
                }
            }
            _ => {
                *self = next;
            }
        };
        Ok(())
    }
    fn validate_with_path(
        &self,
        context: &Self::Context,
        finalizing: bool,
        path: schematic::Path,
    ) -> std::result::Result<(), Vec<schematic::ValidateError>> {
        use schematic::internal::*;
        let mut validate = ValidateManager::new(context, finalizing, path);
        match self {
            Self::A { b: pb, .. } => {
                validate
                    .named_variant(
                        "A",
                        |validate| {
                            if let Some(setting) = pb {
                                validate.nested("b", setting);
                            } else if finalizing {
                                validate
                                    .nested(
                                        "b",
                                        &<<NestedConfig as schematic::Config>::Partial as Default>::default(),
                                    );
                            }
                        },
                    );
            }
            Self::B { c: pa, .. } => {
                validate
                    .named_variant(
                        "B",
                        |validate| {
                            if let Some(setting) = pa {
                                validate
                                    .check(
                                        "c",
                                        setting,
                                        self,
                                        |v, d, c, f| func_ref(v, d, c, f),
                                    );
                            }
                            if pa.is_none() {
                                validate.required("c");
                            }
                        },
                    );
            }
            _ => {}
        };
        if !validate.errors.is_empty() {
            return Err(validate.errors);
        }
        Ok(())
    }
}
