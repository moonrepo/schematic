#[derive(Clone, Debug, PartialEq, serde::Deserialize, serde::Serialize)]
#[serde(tag = "type", deny_unknown_fields)]
enum PartialExample {
    A {
        #[serde(skip_serializing_if = "Option::is_none", default)]
        a: Option<String>,
        #[serde(skip_serializing_if = "Option::is_none", default)]
        b: Option<<NestedConfig as schematic::Config>::Partial>,
    },
    B { #[serde(skip_serializing_if = "Option::is_none", default)] c: Option<bool> },
}
