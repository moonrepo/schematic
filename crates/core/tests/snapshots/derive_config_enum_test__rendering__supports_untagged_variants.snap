#[automatically_derived]
impl schematic::ConfigEnum for Example {
    fn variants() -> Vec<Example> {
        vec![
            Self::Known, Self::Flag(Default::default()), Self::Count(Default::default()),
            Self::Other(Default::default())
        ]
    }
}
#[automatically_derived]
impl std::str::FromStr for Example {
    type Err = schematic::ConfigError;
    fn from_str(value: &str) -> std::result::Result<Self, schematic::ConfigError> {
        let input = value;
        let value = schematic::internal::format_case(value, "lowercase");
        let value = value.as_str();
        Ok(
            match value {
                "Known" => Self::Known,
                unknown => {
                    if let Ok(inner) = <bool as std::str::FromStr>::from_str(input) {
                        return Ok(Self::Flag(inner));
                    }
                    if let Ok(inner) = <u32 as std::str::FromStr>::from_str(input) {
                        return Ok(Self::Count(inner));
                    }
                    Self::Other(
                        unknown
                            .try_into()
                            .map_err(|_| {
                                schematic::ConfigError::EnumInvalidFallback(
                                    unknown.to_string(),
                                )
                            })?,
                    )
                }
            },
        )
    }
}
