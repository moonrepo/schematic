#[automatically_derived]
impl<'de, T: Clone, U> serde::Deserialize<'de> for PartialExample<T, U>
where
    U: Default,
{
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        use serde::de::Error as _;
        let content = schematic::internal::untagged::buffer_untagged_content(
            deserializer,
        )?;
        let mut errors: Vec<(&str, String)> = Vec::new();
        {
            #[derive(serde::Deserialize)]
            #[serde(
                deny_unknown_fields,
                bound(
                    deserialize = "T: serde::de::DeserializeOwned, U: serde::de::DeserializeOwned"
                )
            )]
            struct Variant<T: Clone, U = String>
            where
                U: Default,
            {
                #[serde(skip_serializing_if = "Option::is_none", default)]
                value: Option<T>,
                #[serde(skip)]
                __marker: std::marker::PhantomData<PartialExample<T, U>>,
            }
            match schematic::internal::untagged::deserialize_untagged_variant::<
                Variant<T, U>,
            >(&content) {
                Ok(value) => {
                    return Ok(PartialExample::A {
                        value: value.value,
                    });
                }
                Err(error) => errors.push(("A", error)),
            }
        }
        match schematic::internal::untagged::deserialize_untagged_variant::<
            U,
        >(&content) {
            Ok(value) => return Ok(PartialExample::B(value)),
            Err(error) => errors.push(("B", error)),
        }
        Err(
            D::Error::custom(
                schematic::internal::untagged::untagged_error_message(
                    stringify!(PartialExample),
                    &errors,
                ),
            ),
        )
    }
}
