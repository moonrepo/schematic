fn default_values(
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        Some(Self {
            a: Some(Point { x: 1, y: 2 }),
            b: Some(Wrapper {
                inner: Point { x: 0, y: 0 },
            }),
        }),
    )
}
