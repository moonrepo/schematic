fn merge(
    &mut self,
    context: &Self::Context,
    mut next: Self,
) -> std::result::Result<(), schematic::ConfigError> {
    schematic::internal::merge::MergeManager::new(context)
        .apply_with(&mut self.a, next.a, schematic::merge::merge_list)?
        .apply_with(&mut self.b, next.b, schematic::merge::merge_list)?
        .apply_with(&mut self.c, next.c, schematic::merge::merge_list)?
        .apply_with(&mut self.d, next.d, schematic::merge::merge_list)?
        .apply(&mut self.e, next.e)?
        .apply_with(&mut self.f, next.f, schematic::merge::replace)?;
    Ok(())
}
