fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    let mut validate = schematic::internal::validate::ValidateManager::new(
        context,
        finalizing,
        path,
    );
    match self {
        Self::A(pa) => {
            validate.check_variant("aa", (pa), self, |v, d, c, f| func_ref(v, d, c, f));
        }
        Self::B(pa) => {
            validate.nested_variant("bb", 0usize, pa);
        }
        Self::C(pa) => {
            if pa.is_none() {
                validate.required_variant("cc");
            }
        }
        _ => {}
    };
    validate.finish()
}
