fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    self.env_values_with_prefix(None)
}
fn env_values_with_prefix(
    &self,
    prefix: Option<&str>,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    let mut env = schematic::internal::env::EnvManager::new(prefix, None);
    let mut partial = Self::default();
    partial.a = env.get("STR")?;
    partial.b = env.get("BOOL")?;
    partial.c = env.get("INT")?;
    partial.d = env
        .nested(schematic::internal::layers::nested_env_values(self.d.as_ref(), None)?)?;
    partial.e = env
        .nested(schematic::internal::layers::nested_env_values(self.e.as_ref(), None)?)?;
    Ok(env.finish(partial))
}
