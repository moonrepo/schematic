#[automatically_derived]
impl<'de> serde::Deserialize<'de> for PartialExample {
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let mut attempts = schematic::internal::untagged::UntaggedManager::new(
            deserializer,
        )?;
        if let Some(value) = attempts.variant::<bool>("A") {
            return Ok(PartialExample::A(value));
        }
        if let Some(value) = attempts.variant::<(usize, String)>("bb") {
            return Ok(PartialExample::B(value.0, value.1));
        }
        if let Some(value) = attempts
            .variant::<<NestedConfig as schematic::Config>::Partial>("C")
        {
            return Ok(PartialExample::C(value));
        }
        if let Some(value) = attempts
            .variant::<Option<Vec<<NestedConfig as schematic::Config>::Partial>>>("D")
        {
            return Ok(PartialExample::D(value));
        }
        if attempts.unit("E") {
            return Ok(PartialExample::E);
        }
        Err(attempts.into_error(stringify!(PartialExample)))
    }
}
