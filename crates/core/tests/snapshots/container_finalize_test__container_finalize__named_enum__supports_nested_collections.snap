expression: pretty(container.impl_partial_finalize())
---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    Ok(
        match self {
            Self::A { a: mut pa, b: mut pb, c: mut pc } => {
                if let Some(layer) = pa {
                    pa = Some(
                        layer
                            .into_iter()
                            .map(|layer| schematic::internal::layers::finalize_with_layers(
                                layer,
                                context,
                            ))
                            .collect::<
                                std::result::Result<
                                    Vec<<NestedConfig as schematic::Config>::Partial>,
                                    schematic::ConfigError,
                                >,
                            >()?,
                    );
                }
                if let Some(layer) = pb {
                    pb = Some(
                        schematic::internal::transform::handle_transform_result(
                            "A.b",
                            transform_config(
                                layer
                                    .into_iter()
                                    .map(|(key, layer)| Ok((
                                        key,
                                        schematic::internal::layers::finalize_with_layers(
                                            layer,
                                            context,
                                        )?,
                                    )))
                                    .collect::<
                                        std::result::Result<
                                            HashMap<
                                                String,
                                                <CustomConfig as schematic::Config>::Partial,
                                            >,
                                            schematic::ConfigError,
                                        >,
                                    >()?,
                                context,
                            ),
                        )?,
                    );
                }
                if let Some(layer) = pc {
                    pc = Some(
                        schematic::internal::transform::handle_transform_result(
                            "A.c",
                            transform_config(
                                layer
                                    .into_iter()
                                    .map(|layer| schematic::internal::layers::finalize_with_layers(
                                        layer,
                                        context,
                                    ))
                                    .collect::<
                                        std::result::Result<
                                            BTreeSet<<NestedConfig as schematic::Config>::Partial>,
                                            schematic::ConfigError,
                                        >,
                                    >()?,
                                context,
                            ),
                        )?,
                    );
                }
                Self::A { a: pa, b: pb, c: pc }
            }
            _ => self,
        },
    )
}
