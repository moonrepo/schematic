    #[serde(skip_serializing_if = "Option::is_none")]
    c: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    d: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    e: Option<Vec<String>>,
    #[serde(skip_serializing_if = "Option::is_none")]
    f: Option<HashMap<u8, String>>,
    #[serde(skip_serializing_if = "Option::is_none")]
    g: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    h: Option<Vec<u8>>,
    #[serde(skip_serializing_if = "Option::is_none")]
    i: Option<std::collections::BTreeSet<u8>>,
}
