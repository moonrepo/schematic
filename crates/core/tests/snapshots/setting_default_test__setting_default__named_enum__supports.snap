expression: pretty(container.impl_partial_default_values())
---
fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        match self {
            Self::Foo { .. } => {
                Some(Self::Foo {
                    a: Some(Default::default()),
                })
            }
            Self::Bar { d: pd, .. } => {
                Some(Self::Bar {
                    a: Some(true),
                    b: Some({
                        use schematic::internal::defaults::{
                            DefaultStringViaFromStr as _, DefaultStringViaTryFrom as _,
                        };
                        (&&schematic::internal::defaults::DefaultString::<String>::new())
                            .parse_default("abc")?
                    }),
                    c: None,
                    d: schematic::internal::layers::nested_default_values(
                        pd.as_ref(),
                        context,
                    )?,
                })
            }
            Self::Baz { .. } => {
                Some(Self::Baz {
                    a: Some(Default::default()),
                })
            }
        },
    )
}
