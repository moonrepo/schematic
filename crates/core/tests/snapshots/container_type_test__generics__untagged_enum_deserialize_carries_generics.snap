#[automatically_derived]
impl<'de, T> serde::Deserialize<'de> for PartialExample<T> {
    fn deserialize<D>(deserializer: D) -> std::result::Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        use serde::de::Error as _;
        let content = schematic::internal::buffer_untagged_content(deserializer)?;
        let mut errors: Vec<(&str, String)> = Vec::new();
        match schematic::internal::deserialize_untagged_variant::<T>(&content) {
            Ok(value) => return Ok(PartialExample::Value(value)),
            Err(error) => errors.push(("Value", error)),
        }
        if schematic::internal::is_null_content(&content) {
            return Ok(PartialExample::Nothing);
        }
        errors.push(("Nothing", "expected null".to_owned()));
        Err(
            D::Error::custom(
                schematic::internal::untagged_error_message(
                    stringify!(PartialExample),
                    &errors,
                ),
            ),
        )
    }
}
