expression: pretty(container.impl_partial_finalize())
---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    Ok(
        match self {
            Self::A { a: pa, b: pb, c: pc, d: mut pd, e: pe } => {
                if let Some(layer) = pd {
                    pd = Some(
                        schematic::internal::transform::handle_transform_result(
                            "A.d",
                            transform_string(layer, context),
                        )?,
                    );
                }
                Self::A {
                    a: pa,
                    b: pb,
                    c: pc,
                    d: pd,
                    e: pe,
                }
            }
            _ => self,
        },
    )
}
