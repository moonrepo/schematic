impl<T: Clone> schematic::Schematic for Example<T> {
    fn schema_name() -> Option<String> {
        let mut name = String::from("Example");
        name.push_str(&schematic::schema::schema_name_of::<T>());
        Some(name)
    }
    fn build_schema(mut schema: schematic::SchemaBuilder) -> schematic::Schema {
        use schematic::schema::*;
        schema
            .enumerable(
                EnumType::from_schemas(
                    [
                        Schema {
                            name: Some("Known".into()),
                            ty: Schema::literal_value(
                                    LiteralValue::String("Known".into()),
                                )
                                .ty,
                            ..Default::default()
                        },
                        Schema {
                            name: Some("Other".into()),
                            ty: schema.infer::<T>().ty,
                            ..Default::default()
                        },
                    ],
                    None,
                ),
            )
    }
