#[automatically_derived]
impl schematic::PartialConfig for PartialExample {
    type Context = ();
    const FLATTENS: bool = true;
    const ALLOWS_UNKNOWN_FIELDS: bool = true;
    fn default_values(
        &self,
        context: &Self::Context,
    ) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        Ok(
            Some(Self {
                a: Some(Default::default()),
                child: schematic::internal::layers::nested_default_values(
                    self.child.as_ref(),
                    context,
                )?,
            }),
        )
    }
    fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        self.env_values_with_prefix(None)
    }
    fn env_values_with_prefix(
        &self,
        prefix: Option<&str>,
    ) -> std::result::Result<Option<Self>, schematic::ConfigError> {
        let mut env = schematic::internal::env::EnvManager::new(prefix, None);
        let mut partial = Self::default();
        partial.child = env
            .nested(
                schematic::internal::layers::nested_env_values(
                    self.child.as_ref(),
                    None,
                )?,
            )?;
        Ok(env.finish(partial))
    }
    fn finalize(
        self,
        context: &Self::Context,
    ) -> std::result::Result<Self, schematic::ConfigError> {
        let mut partial = self;
        if let Some(layer) = partial.child {
            partial.child = Some(layer.finalize(context)?);
        }
        Ok(partial)
    }
    fn merge(
        &mut self,
        context: &Self::Context,
        mut next: Self,
    ) -> std::result::Result<(), schematic::ConfigError> {
        schematic::internal::merge::MergeManager::new(context)
            .apply(&mut self.a, next.a)?
            .nested(&mut self.child, next.child)?;
        Ok(())
    }
    fn validate_with_path(
        &self,
        context: &Self::Context,
        finalizing: bool,
        path: schematic::Path,
    ) -> std::result::Result<(), Vec<schematic::ValidateError>> {
        let mut validate = schematic::internal::validate::ValidateManager::new(
            context,
            finalizing,
            path,
        );
        if let Some(setting) = &self.child {
            validate.flattened(setting);
        } else if finalizing {
            validate
                .flattened(
                    &<<Child as schematic::Config>::Partial as Default>::default(),
                );
        }
        validate.finish()
    }
}
