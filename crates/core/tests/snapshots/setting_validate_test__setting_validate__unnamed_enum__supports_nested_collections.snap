fn validate_with_path(
    &self,
    context: &Self::Context,
    finalizing: bool,
    path: schematic::Path,
) -> std::result::Result<(), Vec<schematic::ValidateError>> {
    use schematic::internal::*;
    let mut validate = ValidateManager::new(context, finalizing, path);
    match self {
        Self::A(pa) => {
            validate.check_variant("A", (pa), self, |v, d, c, f| func_ref(v, d, c, f));
            {
                let path = validate.variant_path("A", 0usize);
                let item = pa;
                for (index, item) in item.iter().enumerate() {
                    let path = path.join_index(index);
                    validate.nested_at(path, item);
                }
            }
        }
        Self::B(pa) => {
            validate.check_variant("B", (pa), self, |v, d, c, f| func_ref(v, d, c, f));
            {
                let path = validate.variant_path("B", 0usize);
                let item = pa;
                for (key, item) in item {
                    let path = path.join_key(key);
                    validate.nested_at(path, item);
                }
            }
        }
        Self::C(pa) => {
            validate.check_variant("C", (pa), self, |v, d, c, f| func_ref(v, d, c, f));
            if let Some(pa) = pa {
                {
                    let path = validate.variant_path("C", 0usize);
                    let item = pa;
                    for (index, item) in item.iter().enumerate() {
                        let path = path.join_index(index);
                        validate.nested_at(path, item);
                    }
                }
            }
        }
        Self::D(pa) => {
            let path = validate.variant_path("D", 0usize);
            let item = pa;
            for (index, item) in item.iter().enumerate() {
                let path = path.join_index(index);
                validate.nested_at(path, item);
            }
        }
        Self::E(pa) => {
            let path = validate.variant_path("E", 0usize);
            let item = pa;
            for (key, item) in item {
                let path = path.join_key(key);
                validate.nested_at(path, item);
            }
        }
        Self::F(pa) => {
            if let Some(pa) = pa {
                {
                    let path = validate.variant_path("F", 0usize);
                    let item = pa;
                    for (index, item) in item.iter().enumerate() {
                        let path = path.join_index(index);
                        validate.nested_at(path, item);
                    }
                }
            }
        }
        _ => {}
    };
    if !validate.errors.is_empty() {
        return Err(validate.errors);
    }
    Ok(())
}
