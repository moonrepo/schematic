fn default_values(
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    use schematic::internal::*;
    Ok(
        Some(Self {
            a: Some(10),
            b: Some(10),
            c: Some(vec![1, 2, 3]),
            d: Some(vec![1, 2, 3]),
            e: Some(handle_default_result(String::try_from("abc"))?),
        }),
    )
}
