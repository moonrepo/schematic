const _: () = assert!(
    << Child as schematic::Config > ::Partial as schematic::PartialConfig >
    ::HAS_ENV_PREFIX,
    "`Example::A.child` sets an `env_prefix` for `Child`, which has no effect, as a parent's prefix only applies to the keys a config derives with an `env_prefix` of its own. Add `#[config(env_prefix)]` to `Child`, or remove it here."
);
