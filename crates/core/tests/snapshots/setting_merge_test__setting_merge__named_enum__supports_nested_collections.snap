---
fn merge(
    &mut self,
    context: &Self::Context,
    mut next: Self,
) -> std::result::Result<(), schematic::ConfigError> {
    match self {
        Self::A { a: pa, b: pb, c: pc } => {
            if let Self::A { a: na, b: nb, c: nc } = next {
                schematic::internal::merge::MergeManager::new(context)
                    .apply_with(pa, na, append_vec)?
                    .apply_with(pb, nb, merge_hashmap)?
                    .apply_with(pc, nc, merge_btreeset)?;
            } else {
                *self = next;
            }
        }
        _ => {
            *self = next;
        }
    };
    Ok(())
}
