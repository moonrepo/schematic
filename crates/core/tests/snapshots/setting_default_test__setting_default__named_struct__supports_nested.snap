fn default_values(
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    Ok(
        Some(Self {
            a: <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                context,
            )?,
            b: <<CustomConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                context,
            )?,
        }),
    )
}
