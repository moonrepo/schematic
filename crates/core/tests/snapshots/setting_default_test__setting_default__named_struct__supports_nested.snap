---
fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    let defaults = Self {
        a: schematic::internal::layers::nested_default_values(self.a.as_ref(), context)?,
        b: schematic::internal::layers::nested_default_values(self.b.as_ref(), context)?,
    };
    Ok(
        if matches!(defaults, Self { a : None, b : None, .. }) {
            None
        } else {
            Some(defaults)
        },
    )
}
