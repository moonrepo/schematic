expression: pretty(container.impl_partial_finalize())
---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    Ok(
        match self {
            Self::A(pa) => {
                Self::A(
                    pa
                        .into_iter()
                        .map(|pa| schematic::internal::layers::finalize_with_layers(
                            pa,
                            context,
                        ))
                        .collect::<
                            std::result::Result<
                                Vec<<NestedConfig as schematic::Config>::Partial>,
                                schematic::ConfigError,
                            >,
                        >()?,
                )
            }
            Self::B(pa) => {
                Self::B(
                    transform_config(
                        pa
                            .into_iter()
                            .map(|(key, pa)| Ok((
                                key,
                                schematic::internal::layers::finalize_with_layers(
                                    pa,
                                    context,
                                )?,
                            )))
                            .collect::<
                                std::result::Result<
                                    HashMap<
                                        String,
                                        <CustomConfig as schematic::Config>::Partial,
                                    >,
                                    schematic::ConfigError,
                                >,
                            >()?,
                        context,
                    )?,
                )
            }
            Self::C(pa) => {
                Self::C(
                    transform_config(
                        match pa {
                            Some(pa) => {
                                Some(
                                    pa
                                        .into_iter()
                                        .map(|pa| schematic::internal::layers::finalize_with_layers(
                                            pa,
                                            context,
                                        ))
                                        .collect::<
                                            std::result::Result<
                                                BTreeSet<<NestedConfig as schematic::Config>::Partial>,
                                                schematic::ConfigError,
                                            >,
                                        >()?,
                                )
                            }
                            None => None,
                        },
                        context,
                    )?,
                )
            }
            _ => self,
        },
    )
}
