expression: pretty(container.impl_partial_finalize())
---
fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    use schematic::internal::*;
    Ok(
        match self {
            Self::A { a: na, b: nb } => {
                let mut pa = Some(Default::default());
                let mut pb = Some(Default::default());
                let mut env = EnvManager::new(None::<&str>, Some("PREFIX_"));
                let ea = env.get_and_parse("A", schematic::env::split_comma)?;
                let eb = env.get_and_parse_prefixed("B", schematic::env::split_colon)?;
                MergeManager::new(context)
                    .apply(&mut pa, na)?
                    .apply_with(&mut pb, nb, append_vec)?
                    .apply(&mut pa, ea)?
                    .apply_with(&mut pb, eb, append_vec)?;
                Self::A { a: pa, b: pb }
            }
            _ => self,
        },
    )
}
