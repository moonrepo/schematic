fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    use schematic::internal::*;
    let defaults = Self {
        a: handle_default_result(handler(context))?,
    };
    Ok(if matches!(defaults, Self { a : None, .. }) { None } else { Some(defaults) })
}
