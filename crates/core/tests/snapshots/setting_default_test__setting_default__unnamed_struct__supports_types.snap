fn default_values(
    &self,
    context: &Self::Context,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    use schematic::internal::*;
    Ok(
        Some(
            Self(
                Some(Default::default()),
                Some(true),
                Some(100),
                Some((&&DefaultString::<String>::new()).parse_default("abc")?),
                Some(["a".into(), "b".into(), "c".into()]),
                Some(vec!["a", "b", "c"]),
                Some((10, -10, 0)),
            ),
        ),
    )
}
