fn finalize(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    let mut partial = Self::default();
    if let Some(layer) = Self::default_values(context)? {
        partial.merge(context, layer)?;
    }
    partial.merge(context, self)?;
    if let Some(layer) = Self::env_values()? {
        partial.merge(context, layer)?;
    }
    partial.finalize_nested(context)
}
fn finalize_nested(
    self,
    context: &Self::Context,
) -> std::result::Result<Self, schematic::ConfigError> {
    let mut partial = self;
    if let Some(layer) = partial.a {
        partial.a = Some(layer.finalize_nested(context)?);
    }
    if let Some(layer) = partial.b {
        partial.b = Some(transform_config(layer.finalize_nested(context)?, context)?);
    }
    if let Some(layer) = partial.c {
        partial.c = Some({
            let mut base = <<NestedConfig as schematic::Config>::Partial as schematic::PartialConfig>::default_values(
                    context,
                )?
                .unwrap_or_default();
            base.merge(context, layer)?;
            base.finalize_nested(context)?
        });
    }
    if let Some(layer) = partial.d {
        partial.d = Some(transform_config(layer.finalize_nested(context)?, context)?);
    }
    Ok(partial)
}
