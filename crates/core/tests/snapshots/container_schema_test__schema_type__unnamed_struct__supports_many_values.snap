---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .tuple(
            TupleType::new([
                schema.infer::<String>(),
                {
                    let mut schema = schema.infer::<Vec<usize>>();
                    schema.set_description("Item docs.");
                    schema
                },
                schema.infer_as_nested::<NestedConfig>(),
                schema.infer_as_nested::<Vec<NestedConfig>>(),
                schema.infer_as_nested::<Option<CustomConfig>>(),
            ]),
        )
}
