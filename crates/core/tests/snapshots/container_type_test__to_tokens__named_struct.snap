    type Partial = PartialExample;
    fn from_partial(partial: Self::Partial) -> Self {
        Self {
            enabled: partial.enabled.unwrap_or_default(),
            name: partial.name.unwrap_or_default(),
            port: partial.port,
            nested: {
                let data = partial.nested.unwrap_or_default();
                NestedConfig::from_partial(data)
            },
            list: {
                let data = partial.list.unwrap_or_default();
                {
                    let mut list = Vec::default();
                    for data in data {
                        list.push(NestedConfig::from_partial(data));
                    }
                    list
                }
            },
            extends: Default::default(),
            map: partial.map.unwrap_or_default(),
        }
    }
