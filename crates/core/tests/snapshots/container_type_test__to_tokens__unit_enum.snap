#[derive(Clone, Debug, PartialEq, serde::Deserialize, serde::Serialize)]
#[serde(rename_all = "kebab-case")]
pub enum PartialExample {
    A,
    B,
    C,
}
#[automatically_derived]
impl Default for PartialExample {
    fn default() -> Self {
        Self::B
    }
}
