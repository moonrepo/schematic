---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "some-variant".into(),
                        Schema::structure(
                            StructType::new([
                                (
                                    "some-variant".into(),
                                    SchemaField::new({
                                        let mut item = Schema::structure(
                                            StructType::new([
                                                (
                                                    "someValue".into(),
                                                    SchemaField::new(schema.infer::<String>()),
                                                ),
                                                (
                                                    "other".into(),
                                                    {
                                                        let mut field = SchemaField::new(schema.infer::<String>());
                                                        field.aliases = ["o"]
                                                            .into_iter()
                                                            .map(|alias| alias.to_string())
                                                            .collect::<Vec<_>>();
                                                        field
                                                    },
                                                ),
                                            ]),
                                        );
                                        item.partialize();
                                        item
                                    }),
                                ),
                            ]),
                        ),
                    ),
                    (
                        "other-variant".into(),
                        Schema::structure(
                            StructType::new([
                                (
                                    "other-variant".into(),
                                    SchemaField::new({
                                        let mut item = Schema::structure(
                                            StructType::new([
                                                (
                                                    "SOME_VALUE".into(),
                                                    SchemaField::new(schema.infer::<String>()),
                                                ),
                                            ]),
                                        );
                                        item.partialize();
                                        item
                                    }),
                                ),
                            ]),
                        ),
                    ),
                ],
                None,
            ),
        )
}
