---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "None".into(),
                        {
                            let mut tagged = TaggedType::new(
                                TagFormat::Adjacent {
                                    tag: "kind".into(),
                                    content: "value".into(),
                                },
                                "None",
                                None,
                            );
                            tagged.env_var = Some("AUTH_KIND".into());
                            Schema::tagged(tagged)
                        },
                    ),
                    (
                        "Token".into(),
                        {
                            let mut tagged = TaggedType::new(
                                TagFormat::Adjacent {
                                    tag: "kind".into(),
                                    content: "value".into(),
                                },
                                "Token",
                                Some({
                                    let mut item = Schema::structure(
                                        StructType::new([
                                            (
                                                "token".into(),
                                                {
                                                    let mut field = SchemaField::new(schema.infer::<String>());
                                                    field.env_var = Some("AUTH_TOKEN".into());
                                                    field
                                                },
                                            ),
                                        ]),
                                    );
                                    item.partialize();
                                    item
                                }),
                            );
                            tagged.env_var = Some("AUTH_KIND".into());
                            Schema::tagged(tagged)
                        },
                    ),
                    (
                        "Path".into(),
                        Schema::tagged(
                            TaggedType::new(
                                TagFormat::Adjacent {
                                    tag: "kind".into(),
                                    content: "value".into(),
                                },
                                "Path",
                                Some(schema.infer::<String>()),
                            ),
                        ),
                    ),
                ],
                None,
            ),
        )
}
