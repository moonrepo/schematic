---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "None".into(),
                        schematic::internal::schema::tagged_unit(
                            "kind",
                            {
                                let mut field = SchemaField::new(
                                    Schema::literal_value(LiteralValue::String("None".into())),
                                );
                                field.env_var = Some("AUTH_KIND".into());
                                field
                            },
                        ),
                    ),
                    (
                        "Token".into(),
                        schematic::internal::schema::adjacently_tagged(
                            "kind",
                            {
                                let mut field = SchemaField::new(
                                    Schema::literal_value(LiteralValue::String("Token".into())),
                                );
                                field.env_var = Some("AUTH_KIND".into());
                                field
                            },
                            "value",
                            {
                                let mut item = Schema::structure(
                                    StructType::new([
                                        (
                                            "token".into(),
                                            {
                                                let mut field = SchemaField::new(schema.infer::<String>());
                                                field.env_var = Some("AUTH_TOKEN".into());
                                                field
                                            },
                                        ),
                                    ]),
                                );
                                item.partialize();
                                item
                            },
                        ),
                    ),
                    (
                        "Path".into(),
                        schematic::internal::schema::adjacently_tagged(
                            "kind",
                            SchemaField::new(
                                Schema::literal_value(LiteralValue::String("Path".into())),
                            ),
                            "value",
                            schema.infer::<String>(),
                        ),
                    ),
                ],
                None,
            ),
        )
}
