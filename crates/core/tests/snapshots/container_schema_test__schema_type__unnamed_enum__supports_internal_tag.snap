---
source: crates/core/tests/container_schema_test.rs
expression: pretty_body(container.impl_schematic_type())
---
fn build_schema(mut schema: SchemaBuilder) -> Schema {
    schema
        .union(
            UnionType::from_named_schemas(
                [
                    (
                        "Text".into(),
                        {
                            let mut item = schematic::internal::schema::internally_tagged(
                                schema.infer::<String>(),
                                "type",
                                SchemaField::new(
                                    Schema::literal_value(LiteralValue::String("Text".into())),
                                ),
                            );
                            item.description = Some("Docs.".into());
                            item
                        },
                    ),
                    (
                        "List".into(),
                        schematic::internal::schema::internally_tagged(
                            schema.infer::<Vec<String>>(),
                            "type",
                            SchemaField::new(
                                Schema::literal_value(LiteralValue::String("List".into())),
                            ),
                        ),
                    ),
                    (
                        "Pair".into(),
                        schematic::internal::schema::internally_tagged(
                            Schema::tuple(
                                TupleType::new([
                                    schema.infer::<usize>(),
                                    schema.infer::<bool>(),
                                ]),
                            ),
                            "type",
                            SchemaField::new(
                                Schema::literal_value(LiteralValue::String("Pair".into())),
                            ),
                        ),
                    ),
                    (
                        "Inner".into(),
                        schematic::internal::schema::internally_tagged(
                            {
                                let mut item = schema.infer_as_nested::<NestedConfig>();
                                item.partialize();
                                item
                            },
                            "type",
                            SchemaField::new(
                                Schema::literal_value(LiteralValue::String("Inner".into())),
                            ),
                        ),
                    ),
                    (
                        "InnerOpt".into(),
                        schematic::internal::schema::internally_tagged(
                            {
                                let mut item = schema
                                    .infer_as_nested::<Option<NestedConfig>>();
                                item.partialize();
                                item
                            },
                            "type",
                            SchemaField::new(
                                Schema::literal_value(
                                    LiteralValue::String("InnerOpt".into()),
                                ),
                            ),
                        ),
                    ),
                    (
                        "InnerList".into(),
                        schematic::internal::schema::internally_tagged(
                            {
                                let mut item = schema
                                    .infer_as_nested::<Vec<NestedConfig>>();
                                item.partialize();
                                item
                            },
                            "type",
                            SchemaField::new(
                                Schema::literal_value(
                                    LiteralValue::String("InnerList".into()),
                                ),
                            ),
                        ),
                    ),
                    (
                        "InnerMap".into(),
                        schematic::internal::schema::internally_tagged(
                            {
                                let mut item = schema
                                    .infer_as_nested::<HashMap<String, CustomConfig>>();
                                item.partialize();
                                item
                            },
                            "type",
                            SchemaField::new(
                                Schema::literal_value(
                                    LiteralValue::String("InnerMap".into()),
                                ),
                            ),
                        ),
                    ),
                    (
                        "Unit".into(),
                        schematic::internal::schema::tagged_unit(
                            "type",
                            SchemaField::new(
                                Schema::literal_value(LiteralValue::String("Unit".into())),
                            ),
                        ),
                    ),
                ],
                Some(2usize),
            ),
        )
}
