fn env_values(&self) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    self.env_values_with_prefix(None)
}
fn env_values_with_prefix(
    &self,
    prefix: Option<&str>,
) -> std::result::Result<Option<Self>, schematic::ConfigError> {
    let mut env = schematic::internal::env::EnvManager::new(prefix, Some("PREFIX_"));
    let value = match self {
        Self::A { e: pe, .. } => {
            Self::A {
                a: env.get("OVERRIDE")?,
                long_name: env.get_prefixed("LONG_NAME")?,
                c: env.get_prefixed("RENAMED")?,
                d: None,
                e: env
                    .nested(
                        schematic::internal::layers::nested_env_values(
                            pe.as_ref(),
                            None,
                        )?,
                    )?,
            }
        }
        Self::B { .. } => {
            Self::B {
                c: env.get_prefixed("C")?,
                f: env.get_prefixed("F")?,
            }
        }
        _ => return Ok(None),
    };
    Ok(env.finish(value))
}
