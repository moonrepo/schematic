#[derive(Clone, Debug, Default, PartialEq, serde::Deserialize, serde::Serialize)]
#[serde(default)]
struct PartialExample(
    #[serde(skip_serializing_if = "Option::is_none")]
    pub Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub Option<usize>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub Option<Vec<bool>>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub Option<<NestedConfig as schematic::Config>::Partial>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub Option<Box<str>>,
);
